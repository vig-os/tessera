+/// The CPU time (user + system, all threads) this process has used so far, in seconds, from
+/// `/proc/self/stat` (Linux; clock ticks of `_SC_CLK_TCK`, 100 on every supported target). Unlike
+/// wall time it does not grow when the host is loaded, which is why #828's A3 reports it first.
+fn cpu_seconds() -> f64 {
+    let stat = std::fs::read_to_string("/proc/self/stat").expect("/proc/self/stat");
+    // Fields after the parenthesised command name; utime and stime are the 12th and 13th of them.
+    let rest = &stat[stat.rfind(')').expect("comm") + 2..];
+    let f: Vec<&str> = rest.split_whitespace().collect();
+    let ticks: f64 = f[11].parse::<f64>().unwrap() + f[12].parse::<f64>().unwrap();
+    ticks / 100.0
+}
+
+/// Run `f` as one timed section: returns its result, wall seconds and CPU seconds. When
+/// `T828_PERF_CTL` and `T828_PERF_ACK` name the control and ack FIFOs of a
+/// `perf stat --delay=-1 --control fifo:CTL,ACK` that runs this process, the counters are
+/// enabled for exactly this section, so instruction counts exclude loading the input.
+fn section<R>(f: impl FnOnce() -> R) -> (R, f64, f64) {
+    let perf = match (
+        std::env::var_os("T828_PERF_CTL"),
+        std::env::var_os("T828_PERF_ACK"),
+    ) {
+        (Some(c), Some(a)) => Some((PathBuf::from(c), PathBuf::from(a))),
+        _ => None,
+    };
+    let control = |cmd: &str| {
+        if let Some((ctl, ack)) = &perf {
+            use std::io::{Read, Write};
+            std::fs::OpenOptions::new()
+                .write(true)
+                .open(ctl)
+                .and_then(|mut c| c.write_all(format!("{cmd}\n").as_bytes()))
+                .expect("perf control fifo");
+            let mut buf = [0u8; 5];
+            std::fs::File::open(ack)
+                .and_then(|mut a| a.read(&mut buf))
+                .expect("perf ack fifo");
+        }
+    };
+    control("enable");
+    let (c0, t) = (cpu_seconds(), Instant::now());
+    let r = f();
+    let (wall, cpu) = (t.elapsed().as_secs_f64(), cpu_seconds() - c0);
+    control("disable");
+    (r, wall, cpu)
+}
